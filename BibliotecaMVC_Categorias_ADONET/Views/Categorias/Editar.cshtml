@model BibliotecaMVC.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}

<h2>Editar Categoría</h2>

<div class="card">
    <div class="card-body">
        <form asp-controller="Categorias" asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* El Id viaja oculto: es la llave que usa el WHERE del UPDATE *@
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">ID</label>
                <input class="form-control" value="@Model.Id" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" maxlength="100" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="250"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a class="btn btn-secondary" asp-controller="Categorias" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
