@model BibliotecaMVC.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h2>Eliminar Categoría</h2>

<div class="alert alert-warning">
    <strong>¿Está seguro que desea eliminar esta categoría?</strong>
    Esta acción no se puede deshacer.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>
        </dl>
    </div>
</div>

<form asp-controller="Categorias" asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a class="btn btn-secondary" asp-controller="Categorias" asp-action="Index">Cancelar</a>
</form>
