@model IEnumerable<BibliotecaMVC.Models.Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Gestión de Categorías</h2>
    <a class="btn btn-primary" asp-controller="Categorias" asp-action="Crear">Nueva categoría</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No hay categorías registradas todavía.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="Categorias" asp-action="Editar" asp-route-id="@categoria.Id">
                            Editar
                        </a>
                        <a class="btn btn-sm btn-outline-danger"
                           asp-controller="Categorias" asp-action="Eliminar" asp-route-id="@categoria.Id">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
