@model IEnumerable<string>
@{
    ViewData["Title"] = "Reportes";
}

<div class="mb-4">
    <h2 class="mb-1">Reportes</h2>
    <p class="text-muted mb-0">Genere el catálogo de libros en PDF o Excel a partir de los datos guardados en SQL Server.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h5 class="card-title">Reporte de libros</h5>
        <p class="text-muted">
            Incluye ID, título, autor, editorial, año, ejemplares y estado, junto con la fecha de generación
            y un resumen con el total de libros. Puede limitarlo a un autor.
        </p>

        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="autor" class="form-label">Filtrar por autor</label>
                    <select id="autor" name="autor" class="form-select">
                        <option value="">Todos los autores</option>
                        @foreach (var autor in Model)
                        {
                            <option value="@autor">@autor</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 d-flex flex-wrap gap-2">
                    <button type="submit" asp-controller="Reportes" asp-action="LibrosPdf" class="btn btn-danger">
                        Generar reporte PDF
                    </button>
                    <button type="submit" asp-controller="Reportes" asp-action="LibrosExcel" class="btn btn-success">
                        Exportar a Excel
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
