@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center">
    <div class="col-11 col-md-7 col-lg-6">
        <div class="card border-danger shadow-sm mt-4">
            <div class="card-body text-center p-4">
                <h2 class="mb-3">Acceso denegado</h2>
                <p class="text-muted">
                    Su cuenta inició sesión correctamente, pero el rol que tiene asignado
                    no le permite realizar esta operación.
                </p>
                <p class="text-muted mb-0">
                    Registrar, editar y eliminar libros está reservado para los roles
                    <strong>Admin</strong> y <strong>Bibliotecario</strong>.
                    El rol <strong>Usuario</strong> solo puede consultar el catálogo.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-4">
                    <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ir al catálogo</a>
                    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>
