@model BibliotecaMVC.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-11 col-sm-9 col-md-7 col-lg-5">

        <div class="text-center mb-4">
            <h2 class="mb-1">BibliotecaMVC</h2>
            <p class="text-muted">Ingrese sus credenciales para continuar</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <form asp-controller="Cuenta" asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                    @* Errores generales: credenciales incorrectas, cuenta bloqueada, etc. *@
                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <div>
                                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="UsuarioOCorreo" class="form-label"></label>
                        <input asp-for="UsuarioOCorreo" class="form-control form-control-lg"
                               autocomplete="username" autofocus
                               placeholder="usuario o correo@ejemplo.com" />
                        <span asp-validation-for="UsuarioOCorreo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control form-control-lg"
                               autocomplete="current-password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Iniciar sesión</button>
                    </div>
                </form>

            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-0">
            ¿No tiene una cuenta?
            <a asp-controller="Cuenta" asp-action="Registro"
               asp-route-returnUrl="@ViewData["ReturnUrl"]">Registrarse</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
