@model BibliotecaMVC.Models.ViewModels.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center">
    <div class="col-11 col-sm-9 col-md-7 col-lg-5">

        <div class="text-center mb-4">
            <h2 class="mb-1">Crear cuenta</h2>
            <p class="text-muted">Complete el formulario para registrarse en BibliotecaMVC</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <form asp-controller="Cuenta" asp-action="Registro"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label"></label>
                        <input asp-for="Usuario" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email"
                               placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Mínimo 6 caracteres.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Crear cuenta</button>
                    </div>
                </form>

            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-0">
            ¿Ya tiene una cuenta?
            <a asp-controller="Cuenta" asp-action="Login"
               asp-route-returnUrl="@ViewData["ReturnUrl"]">Iniciar sesión</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
