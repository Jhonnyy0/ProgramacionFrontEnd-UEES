@model IEnumerable<BibliotecaMVC.Models.Autores>
@{
    ViewData["Title"] = "Catálogo de Autores";
}

<h2>Catálogo de Autores</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Nacionalidad</th>
            <th>Fecha de Nacimiento</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Id</td>
                <td>@autor.Nombre</td>
                <td>@autor.Apellido</td>
                <td>@autor.Nacionalidad</td>
                <td>@autor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (autor.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Autores" asp-action="Detalle" asp-route-id="@autor.Id">
                        Ver detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
