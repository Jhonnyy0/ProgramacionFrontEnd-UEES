@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Registrar Libro";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Libros" asp-action="Index">Catálogo de Libros</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Registrar</li>
    </ol>
</nav>

<h2 class="mb-3">Registrar Libro</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="Libros" asp-action="Crear" method="post">
            <partial name="_FormularioLibro" model="Model" />

            <button type="submit" class="btn btn-primary">Guardar libro</button>
            <a class="btn btn-secondary" asp-controller="Libros" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
