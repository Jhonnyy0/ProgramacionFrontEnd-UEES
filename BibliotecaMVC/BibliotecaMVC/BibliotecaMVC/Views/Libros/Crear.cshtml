@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Registrar Libro";
}

<h2 class="mb-3">Registrar Libro</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="Libros" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" maxlength="150"
                           placeholder="Ej. Cien años de soledad" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="AnioPublicacion" class="form-label"></label>
                    <input asp-for="AnioPublicacion" class="form-control" type="number" min="1450" max="2100" />
                    <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Autor" class="form-label"></label>
                    <input asp-for="Autor" class="form-control" maxlength="100" />
                    <span asp-validation-for="Autor" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Editorial" class="form-label"></label>
                    <input asp-for="Editorial" class="form-control" maxlength="100" />
                    <span asp-validation-for="Editorial" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Isbn" class="form-label"></label>
                    <input asp-for="Isbn" class="form-control" maxlength="20" placeholder="978-..." />
                    <span asp-validation-for="Isbn" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Ejemplares" class="form-label"></label>
                    <input asp-for="Ejemplares" class="form-control" type="number" min="1" max="9999" />
                    <span asp-validation-for="Ejemplares" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Disponible" class="form-check-input" role="switch" />
                <label asp-for="Disponible" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar libro</button>
            <a class="btn btn-secondary" asp-controller="Libros" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
