@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Detalle del Libro";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Libros" asp-action="Index">Catálogo de Libros</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<h2 class="mb-3">Detalle del Libro</h2>

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Model.TituloCompleto</h5>
        @if (Model.Disponible)
        {
            <span class="badge bg-success">Disponible</span>
        }
        else
        {
            <span class="badge bg-secondary">No disponible</span>
        }
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Autor</dt>
            <dd class="col-sm-8">@Model.Autor</dd>

            <dt class="col-sm-4">Editorial</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Editorial) ? "—" : Model.Editorial)</dd>

            <dt class="col-sm-4">ISBN</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Isbn) ? "—" : Model.Isbn)</dd>

            <dt class="col-sm-4">Año de publicación</dt>
            <dd class="col-sm-8">@Model.AnioPublicacion</dd>

            <dt class="col-sm-4">Ejemplares</dt>
            <dd class="col-sm-8">@Model.Ejemplares</dd>

            <dt class="col-sm-4">Fecha de registro</dt>
            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Libros" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-outline-danger" asp-controller="Libros" asp-action="Eliminar" asp-route-id="@Model.Id">Eliminar</a>
        <a class="btn btn-secondary ms-auto" asp-controller="Libros" asp-action="Index">Volver al catálogo</a>
    </div>
</div>
