@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Eliminar Libro";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Libros" asp-action="Index">Catálogo de Libros</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
    </ol>
</nav>

<h2 class="mb-3">Eliminar Libro</h2>

<div class="alert alert-danger">
    <strong>¿Está seguro que desea eliminar este libro?</strong>
    El registro se borrará de la base de datos y esta acción no se puede deshacer.
</div>

<div class="card border-danger shadow-sm mb-3">
    <div class="card-header bg-danger-subtle">
        <h5 class="card-title mb-0">@Model.Titulo</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Autor</dt>
            <dd class="col-sm-8">@Model.Autor</dd>

            <dt class="col-sm-4">Editorial</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Editorial) ? "—" : Model.Editorial)</dd>

            <dt class="col-sm-4">ISBN</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Isbn) ? "—" : Model.Isbn)</dd>

            <dt class="col-sm-4">Año de publicación</dt>
            <dd class="col-sm-8">@Model.AnioPublicacion</dd>

            <dt class="col-sm-4">Ejemplares</dt>
            <dd class="col-sm-8">@Model.Ejemplares</dd>
        </dl>
    </div>
</div>

<form asp-controller="Libros" asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a class="btn btn-secondary" asp-controller="Libros" asp-action="Index">Cancelar</a>
</form>
