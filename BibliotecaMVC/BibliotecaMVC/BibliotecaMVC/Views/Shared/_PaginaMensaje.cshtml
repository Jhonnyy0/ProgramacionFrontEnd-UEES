@model BibliotecaMVC.Models.ViewModels.PaginaMensajeViewModel

<div class="row justify-content-center">
    <div class="col-11 col-md-8 col-lg-6">
        <div class="card border-0 shadow text-center mt-4 overflow-hidden">
            <div class="bg-@Model.Color" style="height: 6px;"></div>
            <div class="card-body p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 bg-@Model.Color-subtle text-@Model.Color-emphasis"
                     style="width: 96px; height: 96px;">
                    @if (Model.Icono == "candado")
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    }
                </div>

                <h1 class="h3 fw-bold">@Model.Titulo</h1>
                <p class="text-muted mb-2">@Model.Mensaje</p>
                <p class="text-muted small">@Model.Sugerencia</p>

                <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a>
                    <a class="btn btn-outline-primary" asp-controller="Libros" asp-action="Index">Catálogo de libros</a>
                    <a class="btn btn-outline-primary" asp-controller="Categorias" asp-action="Index">Categorías</a>
                </div>

                @if (!string.IsNullOrEmpty(Model.Referencia))
                {
                    <p class="text-muted small mt-4 mb-0">Código de referencia: <code>@Model.Referencia</code></p>
                }
            </div>
        </div>
    </div>
</div>
