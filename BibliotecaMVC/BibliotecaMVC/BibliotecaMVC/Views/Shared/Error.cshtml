@model BibliotecaMVC.Models.ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un problema";

    var pagina = new BibliotecaMVC.Models.ViewModels.PaginaMensajeViewModel
    {
        Titulo = "Algo salió mal",
        Mensaje = "Ocurrió un problema inesperado mientras procesábamos su solicitud.",
        Sugerencia = "Puede intentarlo de nuevo en unos momentos. Si el problema continúa, comuníquese con el administrador e indique el código de referencia.",
        Color = "danger",
        Icono = "alerta",
        Referencia = Model != null && Model.ShowRequestId ? Model.RequestId : null
    };
}

<partial name="_PaginaMensaje" model="pagina" />
