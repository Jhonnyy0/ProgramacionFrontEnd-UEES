@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav ms-auto align-items-lg-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                Hola, <strong>@UserManager.GetUserName(User)</strong>
                @if (User.IsInRole("Administrador"))
                {
                    <span class="badge bg-primary">Administrador</span>
                }
                else
                {
                    <span class="badge bg-secondary">Usuario</span>
                }
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-primary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
        </li>
    }
</ul>
